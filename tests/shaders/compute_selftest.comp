#version 450

// out[i] = in[i] * scale + offset, for the compute integration test.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { float values[]; } inBuffer;
layout(std430, set = 0, binding = 1) buffer Out { float values[]; } outBuffer;
layout(push_constant) uniform P { float scale; float offset; uint count; } p;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i < p.count)
	{
		outBuffer.values[i] = inBuffer.values[i] * p.scale + p.offset;
	}
}
